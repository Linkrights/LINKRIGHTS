# ------------------------------------------------------------------
# LINKRIGHTS 환경변수 예시 파일
# 이 파일을 복사해서 이름을 .env.local 로 바꾼 뒤 값을 채워 넣으세요.
# .env.local 파일은 절대로 GitHub에 올라가지 않습니다(.gitignore 처리됨).
# ------------------------------------------------------------------

# [필수] OpenAI API 키. https://platform.openai.com/api-keys 에서 발급합니다.
OPENAI_API_KEY=sk-여기에_발급받은_키를_붙여넣으세요

# [선택] 사용할 AI 모델 이름. 비워두면 gpt-4o-mini(저렴한 모델)를 사용합니다.
OPENAI_MODEL=gpt-4o-mini

# [선택] 하루 전체 AI 질문 허용 횟수(비용 상한선). 기본값 500
DAILY_REQUEST_LIMIT=500

# [선택] 한 사람이 5분 동안 물어볼 수 있는 최대 횟수. 기본값 6
RATE_LIMIT_PER_WINDOW=6

# [선택] 사이트 주소. 배포 후 실제 도메인으로 바꿔주세요(SEO에 사용).
NEXT_PUBLIC_SITE_URL=https://linkrights.example.org
